__pycache__/
*.pyc
runlogs/
dist/
.venv/
# Local model weights stay on the machine; the repository records how they are used.
models/
# The call desk is its own published checkout (alacripose/popit-call); it is copied here
# for the companion run, not vendored into this history.
call-client/
# The settings publisher's private half stays on the machine that signs with it. The
# public half, settings.pem, is what another window needs to check a signature.
settings.key
# A prose inventory is a scan dump. It records home paths and whatever a skill document
# quoted, so it is regenerated on the machine that scans instead of being committed.
docs/prose/*/inventory.json
# The family ratchet receipt is the same kind of dump at family scale: every project's strings,
# home paths and LAN addresses. The gate reads it from the machine that ran the pass.
artifacts/receipts/prose-ratchet.json

# The tunnel helper downloads its own binary onto this machine; it is not vendored.
tools/bin/

# The desk's live reading: window handles, titles and revisions of this machine's desk.
state.json
